# small bridge page that loads it, *is* tracked -- only this vendored part
# is gitignored.)
third_party/monaco/

# Release-building notes kept locally only; not shown to people browsing the repo.
windows/README.md
third_party/README.md

# Real Firebase/Google OAuth config -- GOOGLE_OAUTH_CLIENT_SECRET's GOCSPX-...
# shape trips GitHub's push protection, and there's no external contributor
# audience for the rest of it either (see README's Getting Started). Copy
# config.h.example (tracked) to config.h and fill in real values locally.
config.h
