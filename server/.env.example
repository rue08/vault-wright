# Copy to .env and fill in. No Firebase secrets are needed here -- the backend verifies
# Firebase ID tokens using Google's public JWKS, not a service account.
#
# docker-compose.yml builds DB_URL and sets PORT itself, so only these three are needed.
# Generate the password with `openssl rand -hex 24` (hex keeps it URL-safe, since it is
# embedded in the connection string). Never reuse a real password from another project.
POSTGRES_USER=vaultwright
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=vaultwright
